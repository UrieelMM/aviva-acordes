rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Todas las personas autenticadas comparten la misma biblioteca.
    match /songs/{songId} {
      allow read, create, update, delete: if signedIn();
    }

    match /setlists/{setlistId} {
      allow read, create, update, delete: if signedIn();
    }

    // El historial es compartido, pero un usuario solo puede escribir entradas
    // asociadas a su propia sesión de Firebase.
    match /history/{historyId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
