# Copia este archivo como .env.local y pega el objeto firebaseConfig de tu app web.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Opcional: Firebase Analytics. La app funciona sin esta variable.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Opcional: reemplaza el ID de cliente OAuth web integrado si cambias de proyecto.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
